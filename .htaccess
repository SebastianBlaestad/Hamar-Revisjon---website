# Block web access to secrets, backups of them, and log files.
# Editor/FTP backups like config.php.bak or config.php~ would otherwise be
# served as plain text, exposing the keys.
<FilesMatch "^(\.env.*|config\.php\.\w+|.*\.(bak|old|orig|save|swp|tmp)|.*~|error_log\.txt|response_log\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Content-Security-Policy.
#
# Google-domenene for reCAPTCHA (www.google.com, www.gstatic.com) tillates KUN
# på kontaktsiden, siden det er den eneste siden som kan laste reCAPTCHA - og
# der først etter samtykke. De tre andre sidene kan dermed ikke laste det i det
# hele tatt, uansett hva som skulle komme inn i markup senere.
#
# fonts.googleapis.com og fonts.gstatic.com er også Google, men leverer bare
# skriftfilen Inter og lagrer ingenting i nettleseren. Den må være tillatt på
# alle sider for at siden skal se riktig ut.
#
# 'unsafe-inline' for style er nødvendig fordi markupen bruker inline
# style-attributter (style="--d:.1s") til animasjonsforsinkelser, og Leaflet
# setter inline stil på kartlagene. Det gjelder bare stil, ikke script.
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Kontaktsiden: legger til Leaflet (unpkg), kartfliser (OpenStreetMap) og
  # reCAPTCHA (Google). Header set erstatter regelen over for denne filen.
  <FilesMatch "^kontaktskjema\.html$">
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com https://www.gstatic.com; connect-src 'self' https://www.google.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </FilesMatch>
</IfModule>

# Enable the rewrite engine
RewriteEngine On

# Ensure the server recognizes the .htaccess file
Options +FollowSymLinks

# Remove .html extensions from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# Redirect to homepage without showing "index.html"
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect "om_oss.html" and "kontaktskjema.html" to clean URLs
RewriteRule ^om_oss$ om_oss.html [NC,L]
RewriteRule ^kontaktskjema$ kontaktskjema.html [NC,L]
RewriteCond %{THE_REQUEST} /om_oss\.html [NC]
RewriteRule ^om_oss\.html$ /om_oss [R=301,L]
RewriteCond %{THE_REQUEST} /kontaktskjema\.html [NC]
RewriteRule ^kontaktskjema\.html$ /kontaktskjema [R=301,L]

# Redirect back to homepage without showing "index.html" from any page
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Force HTTPS and www (if needed)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.hamarrevisjon.no/$1 [R=301,L]

AddType application/manifest+json .webmanifest
AddType image/png .png
